// PLC Browser IO - single-source WebSocket bridge for TIA Portal V18 / S7-1500
// Import as ONE external source, then 'Generate blocks from source'.
//
// WHAT THIS IS
//   An RFC 6455 WebSocket server running on the PLC. A browser connects to
//   ws://<PLC_IP>:8082 and exchanges two raw byte images with the CPU every cycle.
//   The transport is GENERIC: it ships whatever bytes are in the output image and
//   receives into the input image, sized AUTOMATICALLY from the array lengths -
//   no payload size is hard-coded. You define the dataset in the webpage; it
//   generates the matching struct + pack/unpack source (little-endian, Siemens-
//   specific) that you drop in beside this file.
//
// ARCHITECTURE (block roles)
//   FIXED, never edit:
//     FB_WS_Server  - the WebSocket engine (handshake, framing, TRCV/TSEND).
//     FB_WS_Bridge  - top wrapper: auto-sizes the transfer + manages watchdogs.
//     FC_WS_* (SHA1/Base64/FindKey/BuildAccept/ParseFrame/BuildFrame) - RFC 6455.
//   SHAPE-SPECIFIC, generated by the webpage (replace when the dataset changes):
//     UDT_App_Inputs / UDT_App_Outputs   - typed view of your data.
//     FC_WS_MapInputs / FC_WS_MapOutputs - pack/unpack typed <-> wire (little-endian).
//     DB_WS_Input.Raw / DB_WS_Output.Raw - wire image size.
//
// BEFORE DOWNLOAD
//   1) Create a TCP connection in the device configuration: passive (server),
//      local port 8082. Note its "Local ID" (TIA default for the first one is
//      16#0100). This CONFIGURED connection + basic TRCV/TSEND is the ONLY
//      transport that works on PLCSIM Advanced (see README).
//   2) Set OB 'Main' -> ConnectionID to that Local ID.
//   Recommended block numbers 8080+ so they do not clash with your program (README).


// --- UDT_WS_Frame.scl ---
TYPE "UDT_WS_Frame"
VERSION : 0.1
   STRUCT
      xFin          : Bool;                    // FIN bit
      byOpcode      : Byte;                     // Raw opcode 0x0..0xA (0=cont,1=text,2=binary,8=close,9=ping,10=pong)
      xMasked       : Bool;                     // MASK bit (must be TRUE for browser -> server)
      uiPayloadLen  : UInt;                     // Payload length in bytes (0..240 supported)
      abMaskKey     : Array[0..3] of Byte;      // 4-byte masking key from client
      abPayload     : Array[0..255] of Byte;    // Unmasked payload (max 256, spec limits app to 240)
      uiTotalLen    : UInt;                     // Total frame length (header + mask + payload)
      xValid        : Bool;                     // TRUE if a full frame was decoded
   END_STRUCT;
END_TYPE


// --- UDT_WS_Config.scl ---
TYPE "UDT_WS_Config"
VERSION : 0.2
   STRUCT
      // Hardware identifier of the PROFINET interface of the CPU 1513-1 PN.
      // In TIA: Device configuration -> PROFINET interface [X1] -> Properties ->
      // "Hardware identifier". Paste that constant here (e.g. 64 / 16#40).
      hwInterfaceId : HW_ANY  := 64;
      // Connection ID for the Open User Communication compact blocks. For V3 this
      // MUST equal the "Local ID" of the CONFIGURED TCP connection you created in
      // the device configuration. TIA's default for the first connection is 16#0100.
      connectionId  : CONN_OUC := 16#0100;
      // TCP local port the browser connects to: ws://<PLC_IP>:8082
      // Informational only in V3 - the port is defined by the configured connection.
      localPort     : UInt     := 8082;
      // Cyclic send period target (browser expects ~10 ms).
      sendInterval  : Time     := T#10ms;
      // Time without a change of the incoming watchdog byte before WatchdogError is set.
      watchdogTimeout : Time   := T#500ms;
   END_STRUCT;
END_TYPE


// --- UDT_WS_Status.scl ---
TYPE "UDT_WS_Status"
VERSION : 0.1
   STRUCT
      // --- State machine ---
      uiState          : UInt;   // Current FB_WS_Server state (see constants in FB)
      xTcpConnected    : Bool;   // TCP connection to a client is established
      xHandshakeDone   : Bool;   // WebSocket HTTP upgrade completed
      xClientConnected : Bool;   // Handshake done AND link active
      // --- Last OUC operation and STATUS words ---
      uiLastOp         : UInt;   // 2=TRCV 3=TSEND 4=disconnect/recycle
      wTconStatus      : Word;   // (unused in V3) kept for layout compatibility
      wTrcvStatus      : Word;   // Last STATUS of TRCV
      wTsendStatus     : Word;   // Last STATUS of TSEND
      wTdisconStatus   : Word;   // (unused in V3)
      // --- Counters ---
      udiRxBytes       : UDInt;  // Total TCP bytes received
      udiRxFrames      : UDInt;  // Binary frames received
      udiTxFrames      : UDInt;  // Binary frames transmitted (TSEND DONE, purpose 3)
      udiTxQueued      : UDInt;  // Times an app frame was queued to TSEND (proves the send trigger fires)
      udiTxWedged      : UDInt;  // Times a send was force-aborted after stalling (TSEND never DONE)
      wTxWedgedStatus  : Word;   // TSEND STATUS latched the moment a send was declared wedged
      uiTxMaxHold      : UInt;   // Max scans a single send stayed pending (0-2 = healthy, large = stall)
      uiLastRxPayload  : UInt;   // Size of last received application payload
      uiLastTxPayload  : UInt;   // Size of last transmitted application payload
      udiProtocolErrors: UDInt;  // WebSocket-protocol errors (bad frame, oversize, ...)
      udiTransportErr  : UDInt;  // TCP/OUC transport errors
      udiReconnects    : UDInt;  // Number of reconnect cycles
      // --- Watchdog ---
      xWatchdogError   : Bool;   // Incoming watchdog stopped changing for > timeout
      byLastWatchdogIn : Byte;   // Last observed incoming watchdog value
      udiWatchdogChanges : UDInt;// Count of incoming watchdog changes
      // --- Buffers ---
      xRxOverflow      : Bool;   // RX stream buffer overflowed (protocol desync guard)
      uiStreamLen      : UInt;   // Current bytes held in the RX stream buffer
      // --- V3 handshake diagnostics ---
      udiTrcvErrCnt    : UDInt;  // Scans TRCV reported ERROR
      wLastTrcvErr     : Word;   // Last non-zero TRCV error status (latched)
      udiHdrFound      : UDInt;  // Times the CR LF CR LF request terminator was located
      udiHsSent        : UDInt;  // Times the 101 handshake response was queued to TSEND
      udiStaleResync   : UDInt;  // Times the RX buffer was reset to recover from stale data
      wLastTsendErr    : Word;   // Last non-zero TSEND error status (latched)
      uiDiscFrom       : UInt;   // State the last ST_DISCONNECT was entered from (latched)
      uiDiscReason     : UInt;   // Why: 1=RX err 2=handshake key missing 3=TX err 4=close/protocol
      // --- ground-truth taps (sampled at end of every scan) ---
      udiHsRecvScans   : UDInt;            // Times the ST_HS_RECV body executed
      uiStreamLenLive  : UInt;             // Real streamLen at end of scan (vs the uiStreamLen copy)
      abStreamHead     : Array[0..31] of Byte;  // First 32 bytes of streamBuf (verify the request landed intact)
      // --- rolling human-readable event trace (see FC_WS_Trace) ---
      uiTraceIdx       : UInt;                       // total events; newest entry = asTrace[(uiTraceIdx-1) MOD 16]
      asTrace          : Array[0..15] of String[32]; // what actually happened, in order
   END_STRUCT;
END_TYPE


// --- UDT_App_Inputs.scl ---
TYPE "UDT_App_Inputs"
VERSION : 0.1
//  Application view of the Browser->PLC payload (39 bytes).
//  Byte offsets are DERIVED from webpage/plc-core.js IOHandler.sortSignals()
//  for webpage/config/simulation_project.json. They are the wire contract:
//  do not reorder without regenerating the browser layout.
   STRUCT
      uiWatchdog_Inputs : Byte;                 // offset 0    (browser increments % 255)
      rSpeedSetpoint    : Real;                 // offset 4    little-endian on the wire
      diEncoderRaw      : DInt;                 // offset 8
      iTargetPosition   : Int;                  // offset 12
      uiCycleCount      : UInt;                 // offset 14
      xStart            : Bool;                 // offset 16.0
      xModeAuto         : Bool;                 // offset 16.1
      byStatusBits      : Byte;                 // offset 17
      sProductName      : Array[0..20] of Char; // offset 18  (20 chars + NUL = 21 bytes)
   END_STRUCT;
END_TYPE


// --- UDT_App_Outputs.scl ---
TYPE "UDT_App_Outputs"
VERSION : 0.1
//  Application view of the PLC->Browser payload (59 bytes).
//  Byte offsets are DERIVED from webpage/plc-core.js IOHandler.sortSignals()
//  for webpage/config/simulation_project.json. Wire contract - do not reorder.
   STRUCT
      uiWatchdog_Outputs : Byte;                 // offset 0    (cycled by FB_WS_Bridge each scan)
      rActualSpeed       : Real;                 // offset 4    little-endian on the wire
      diEncoderFeedback  : DInt;                 // offset 8
      iActualPosition    : Int;                  // offset 12
      uiErrorID          : UInt;                 // offset 14
      xLightWarning      : Bool;                 // offset 16.0
      xMotorRunning      : Bool;                 // offset 16.1
      byErrorCode        : Byte;                 // offset 17
      sLogMessage        : Array[0..40] of Char; // offset 18  (40 chars + NUL = 41 bytes)
   END_STRUCT;
END_TYPE


// --- FC_MkDW.scl ---
FUNCTION "FC_MkDW" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Build a DWord from four byte literals: (b3 b2 b1 b0) -> 0xB3B2B1B0.
//  Needed because this toolchain rejects untyped hex constants > 16#7FFFFFFF
//  (they are typed as DInt and overflow), so 32-bit SHA-1 constants are assembled
//  from bytes (each <= 255) using DWord bit operations only.
VAR_INPUT
   b3 : Byte;
   b2 : Byte;
   b1 : Byte;
   b0 : Byte;
END_VAR
BEGIN
   FC_MkDW := SHL(IN := BYTE_TO_DWORD(b3), N := 24)
           OR SHL(IN := BYTE_TO_DWORD(b2), N := 16)
           OR SHL(IN := BYTE_TO_DWORD(b1), N := 8)
           OR BYTE_TO_DWORD(b0);
END_FUNCTION


// --- FC_U2D.scl ---
FUNCTION "FC_U2D" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  UDInt -> DWord bit-preserving cast.
//  S7-1500 has no same-size numeric->bitstring conversion (UDINT_TO_DWORD is not an
//  instruction), so the 32-bit value is split into bytes with arithmetic (narrowing
//  INT_TO_BYTE is available) and reassembled with DWord bit operations.
//  Used by FC_WS_SHA1 to bring modular-2^32 sums back into DWord form.
VAR_INPUT
   u : UDInt;
END_VAR
VAR_TEMP
   b0 : Byte;
   b1 : Byte;
   b2 : Byte;
   b3 : Byte;
END_VAR
BEGIN
   b0 := INT_TO_BYTE(UDINT_TO_INT(u MOD 256));
   b1 := INT_TO_BYTE(UDINT_TO_INT((u / 256) MOD 256));
   b2 := INT_TO_BYTE(UDINT_TO_INT((u / 65536) MOD 256));
   b3 := INT_TO_BYTE(UDINT_TO_INT((u / 16777216) MOD 256));
   FC_U2D := SHL(IN := BYTE_TO_DWORD(b3), N := 24)
          OR SHL(IN := BYTE_TO_DWORD(b2), N := 16)
          OR SHL(IN := BYTE_TO_DWORD(b1), N := 8)
          OR BYTE_TO_DWORD(b0);
END_FUNCTION


// --- FC_WS_SHA1.scl ---
FUNCTION "FC_WS_SHA1" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.4
//  Synchronous SHA-1 over data[0 .. msgLen-1]. Result in hash[0..19].
//  Constraints of this toolchain, all worked around here:
//    - no arrays of DWord           -> hash + 16-word schedule are scalar DWords
//    - no untyped hex literal > 2^31 -> 32-bit constants assembled from byte SHL/OR
//    - no same-size numeric<->bitstring reinterpret -> modular add via FC_U2D
//    - one variable per declaration line (comma lists rejected for DWord here)
//  Message schedule is a shift register: s0=oldest .. s15=newest;
//  for i>=16: w[i]=ROL(s13 xor s8 xor s2 xor s0, 1). Test: SHA1(abc)=A9993E36...
VAR_INPUT
   msgLen  : UDInt;
END_VAR
VAR_IN_OUT
   data : Array[*] of Byte;
   hash : Array[0..19] of Byte;
END_VAR
VAR_TEMP
   h0 : DWord;
   h1 : DWord;
   h2 : DWord;
   h3 : DWord;
   h4 : DWord;
   a : DWord;
   b : DWord;
   c : DWord;
   d : DWord;
   e : DWord;
   f : DWord;
   k : DWord;
   x : DWord;
   newW : DWord;
   k0 : DWord;
   k1 : DWord;
   k2 : DWord;
   k3 : DWord;
   s0 : DWord;
   s1 : DWord;
   s2 : DWord;
   s3 : DWord;
   s4 : DWord;
   s5 : DWord;
   s6 : DWord;
   s7 : DWord;
   s8 : DWord;
   s9 : DWord;
   s10 : DWord;
   s11 : DWord;
   s12 : DWord;
   s13 : DWord;
   s14 : DWord;
   s15 : DWord;
   block : UDInt;
   totalBlocks : UDInt;
   bytesLast : UDInt;
   pos : UDInt;
   bitLen : UDInt;
   n : Int;
   z : Int;
   abBuf : Array[0..63] of Byte;
   padDone : Bool;
END_VAR
BEGIN
   // hash init constants, assembled from bytes (no >2^31 literal)
   h0 := SHL(IN := BYTE_TO_DWORD(16#67), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#45), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#23), N := 8) OR BYTE_TO_DWORD(16#01);
   h1 := SHL(IN := BYTE_TO_DWORD(16#EF), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#CD), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#AB), N := 8) OR BYTE_TO_DWORD(16#89);
   h2 := SHL(IN := BYTE_TO_DWORD(16#98), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#BA), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#DC), N := 8) OR BYTE_TO_DWORD(16#FE);
   h3 := SHL(IN := BYTE_TO_DWORD(16#10), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#32), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#54), N := 8) OR BYTE_TO_DWORD(16#76);
   h4 := SHL(IN := BYTE_TO_DWORD(16#C3), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#D2), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#E1), N := 8) OR BYTE_TO_DWORD(16#F0);

   k0 := SHL(IN := BYTE_TO_DWORD(16#5A), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#82), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#79), N := 8) OR BYTE_TO_DWORD(16#99);
   k1 := SHL(IN := BYTE_TO_DWORD(16#6E), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#D9), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#EB), N := 8) OR BYTE_TO_DWORD(16#A1);
   k2 := SHL(IN := BYTE_TO_DWORD(16#8F), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#1B), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#BC), N := 8) OR BYTE_TO_DWORD(16#DC);
   k3 := SHL(IN := BYTE_TO_DWORD(16#CA), N := 24) OR SHL(IN := BYTE_TO_DWORD(16#62), N := 16) OR SHL(IN := BYTE_TO_DWORD(16#C1), N := 8) OR BYTE_TO_DWORD(16#D6);

   bytesLast := msgLen MOD 64;
   IF bytesLast > 55 THEN
      totalBlocks := (msgLen / 64) + 2;
   ELSE
      totalBlocks := (msgLen / 64) + 1;
   END_IF;

   bitLen  := msgLen * 8;
   pos     := 0;
   padDone := FALSE;

   FOR block := 0 TO totalBlocks - 1 DO
      FOR n := 0 TO 63 DO
         IF pos + INT_TO_UDINT(n) < msgLen THEN
            abBuf[n] := data[UDINT_TO_DINT(pos + INT_TO_UDINT(n))];
         ELSIF (pos + INT_TO_UDINT(n) = msgLen) AND NOT padDone THEN
            abBuf[n] := 16#80;
            padDone  := TRUE;
         ELSE
            abBuf[n] := 0;
         END_IF;
      END_FOR;

      IF block = totalBlocks - 1 THEN
         abBuf[56] := 0;
         abBuf[57] := 0;
         abBuf[58] := 0;
         abBuf[59] := 0;
         abBuf[60] := INT_TO_BYTE(UDINT_TO_INT((bitLen / 16777216) MOD 256));
         abBuf[61] := INT_TO_BYTE(UDINT_TO_INT((bitLen / 65536) MOD 256));
         abBuf[62] := INT_TO_BYTE(UDINT_TO_INT((bitLen / 256) MOD 256));
         abBuf[63] := INT_TO_BYTE(UDINT_TO_INT(bitLen MOD 256));
      END_IF;

      pos := pos + 64;

      a := h0;
      b := h1;
      c := h2;
      d := h3;
      e := h4;

      FOR n := 0 TO 79 DO
         IF n < 16 THEN
            z := n * 4;
            newW := SHL(IN := BYTE_TO_DWORD(abBuf[z]),     N := 24)
                 OR SHL(IN := BYTE_TO_DWORD(abBuf[z + 1]), N := 16)
                 OR SHL(IN := BYTE_TO_DWORD(abBuf[z + 2]), N := 8)
                 OR BYTE_TO_DWORD(abBuf[z + 3]);
         ELSE
            newW := ROL(IN := s13 XOR s8 XOR s2 XOR s0, N := 1);
         END_IF;

         IF n <= 19 THEN
            f := (b AND c) OR ((NOT b) AND d);
            k := k0;
         ELSIF n <= 39 THEN
            f := b XOR c XOR d;
            k := k1;
         ELSIF n <= 59 THEN
            f := (b AND c) OR (b AND d) OR (c AND d);
            k := k2;
         ELSE
            f := b XOR c XOR d;
            k := k3;
         END_IF;

         x := "FC_U2D"( DWORD_TO_UDINT(ROL(IN := a, N := 5))
                      + DWORD_TO_UDINT(f)
                      + DWORD_TO_UDINT(e)
                      + DWORD_TO_UDINT(k)
                      + DWORD_TO_UDINT(newW) );
         e := d;
         d := c;
         c := ROL(IN := b, N := 30);
         b := a;
         a := x;

         s0 := s1;
         s1 := s2;
         s2 := s3;
         s3 := s4;
         s4 := s5;
         s5 := s6;
         s6 := s7;
         s7 := s8;
         s8 := s9;
         s9 := s10;
         s10 := s11;
         s11 := s12;
         s12 := s13;
         s13 := s14;
         s14 := s15;
         s15 := newW;
      END_FOR;

      h0 := "FC_U2D"(DWORD_TO_UDINT(h0) + DWORD_TO_UDINT(a));
      h1 := "FC_U2D"(DWORD_TO_UDINT(h1) + DWORD_TO_UDINT(b));
      h2 := "FC_U2D"(DWORD_TO_UDINT(h2) + DWORD_TO_UDINT(c));
      h3 := "FC_U2D"(DWORD_TO_UDINT(h3) + DWORD_TO_UDINT(d));
      h4 := "FC_U2D"(DWORD_TO_UDINT(h4) + DWORD_TO_UDINT(e));
   END_FOR;

   hash[0]  := DWORD_TO_BYTE(SHR(IN := h0, N := 24));
   hash[1]  := DWORD_TO_BYTE(SHR(IN := h0, N := 16) AND 16#FF);
   hash[2]  := DWORD_TO_BYTE(SHR(IN := h0, N := 8)  AND 16#FF);
   hash[3]  := DWORD_TO_BYTE(h0 AND 16#FF);
   hash[4]  := DWORD_TO_BYTE(SHR(IN := h1, N := 24));
   hash[5]  := DWORD_TO_BYTE(SHR(IN := h1, N := 16) AND 16#FF);
   hash[6]  := DWORD_TO_BYTE(SHR(IN := h1, N := 8)  AND 16#FF);
   hash[7]  := DWORD_TO_BYTE(h1 AND 16#FF);
   hash[8]  := DWORD_TO_BYTE(SHR(IN := h2, N := 24));
   hash[9]  := DWORD_TO_BYTE(SHR(IN := h2, N := 16) AND 16#FF);
   hash[10] := DWORD_TO_BYTE(SHR(IN := h2, N := 8)  AND 16#FF);
   hash[11] := DWORD_TO_BYTE(h2 AND 16#FF);
   hash[12] := DWORD_TO_BYTE(SHR(IN := h3, N := 24));
   hash[13] := DWORD_TO_BYTE(SHR(IN := h3, N := 16) AND 16#FF);
   hash[14] := DWORD_TO_BYTE(SHR(IN := h3, N := 8)  AND 16#FF);
   hash[15] := DWORD_TO_BYTE(h3 AND 16#FF);
   hash[16] := DWORD_TO_BYTE(SHR(IN := h4, N := 24));
   hash[17] := DWORD_TO_BYTE(SHR(IN := h4, N := 16) AND 16#FF);
   hash[18] := DWORD_TO_BYTE(SHR(IN := h4, N := 8)  AND 16#FF);
   hash[19] := DWORD_TO_BYTE(h4 AND 16#FF);
END_FUNCTION


// --- FC_WS_Base64.scl ---
FUNCTION "FC_WS_Base64" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
//  Base64-encode inp[0..msgLen-1] into outp[0..]. Returns encoded length (chars).
//  The alphabet is computed arithmetically (no String / no string indexing),
//  to avoid a toolchain quirk with the 64-char String literal.
VAR_INPUT
   msgLen   : UInt;                       // number of input bytes
END_VAR
VAR_IN_OUT
   inp   : Array[*] of Byte;           // input bytes (0-based)
   outp  : Array[*] of Byte;           // output ASCII (0-based)
END_VAR
VAR_TEMP
   i      : Int;
   outIdx : Int;
   bits   : Int;                       // accumulated bit count
   buf    : DWord;                     // bit buffer
   val    : Int;                       // current 6-bit group value 0..63
   cb     : Int;                       // ASCII code of the base64 char
   padCnt : Int;
   dwMask : DWord;
END_VAR
BEGIN
   outIdx := 0;
   bits   := 0;
   buf    := 0;

   FOR i := 0 TO UINT_TO_INT(msgLen) - 1 DO
      buf  := SHL(IN := buf, N := 8) OR BYTE_TO_DWORD(inp[i]);
      bits := bits + 8;

      WHILE bits >= 6 DO
         bits := bits - 6;
         val  := BYTE_TO_INT(DWORD_TO_BYTE(SHR(IN := buf, N := bits) AND 16#3F));
         // value -> ASCII: A-Z a-z 0-9 + /
         IF   val < 26 THEN cb := 65 + val;
         ELSIF val < 52 THEN cb := 97 + val - 26;
         ELSIF val < 62 THEN cb := 48 + val - 52;
         ELSIF val = 62 THEN cb := 43;
         ELSE               cb := 47;
         END_IF;
         outp[outIdx] := INT_TO_BYTE(cb);
         outIdx := outIdx + 1;
         dwMask := NOT BYTE_TO_DWORD(0);          // 0xFFFFFFFF without a >2^31 literal
         buf := buf AND NOT SHL(IN := dwMask, N := bits);
      END_WHILE;
   END_FOR;

   // remaining bits + '=' padding
   IF bits > 0 THEN
      val := BYTE_TO_INT(DWORD_TO_BYTE(SHL(IN := buf, N := (6 - bits)) AND 16#3F));
      IF   val < 26 THEN cb := 65 + val;
      ELSIF val < 52 THEN cb := 97 + val - 26;
      ELSIF val < 62 THEN cb := 48 + val - 52;
      ELSIF val = 62 THEN cb := 43;
      ELSE               cb := 47;
      END_IF;
      outp[outIdx] := INT_TO_BYTE(cb);
      outIdx := outIdx + 1;

      padCnt := (4 - (outIdx MOD 4)) MOD 4;
      FOR i := 1 TO padCnt DO
         outp[outIdx] := 16#3D;          // '='
         outIdx := outIdx + 1;
      END_FOR;
   END_IF;

   FC_WS_Base64 := outIdx;
END_FUNCTION


// --- FC_WS_FindKey.scl ---
FUNCTION "FC_WS_FindKey" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Scan an accumulated HTTP request in buf[0..dataLen-1] for the header
//  "Sec-WebSocket-Key:" and copy its value into keyOut.
//  Returns the key length (0 = not found / empty).  Header match is
//  case-insensitive on the name; the value is read verbatim.
VAR_INPUT
   dataLen : UInt;                     // valid bytes in buf
END_VAR
VAR_IN_OUT
   buf     : Array[*] of Byte;         // raw HTTP bytes (0-based)
   keyOut  : Array[0..39] of Byte;     // extracted key value
END_VAR
VAR_TEMP
   sHdr    : String[24];
   hdrLen  : Int;
   i       : Int;
   j       : Int;
   match   : Bool;
   keyLen  : Int;
   ba      : Byte;
   bb      : Byte;
END_VAR
BEGIN
   FC_WS_FindKey := 0;
   sHdr   := 'sec-websocket-key:';       // compared lower-cased
   hdrLen := LEN(sHdr);                   // = 18

   IF dataLen < 40 THEN
      RETURN;
   END_IF;

   i := 0;
   WHILE i <= UINT_TO_INT(dataLen) - hdrLen DO
      match := TRUE;
      FOR j := 0 TO hdrLen - 1 DO
         ba := buf[i + j];
         // to-lower ASCII 'A'..'Z'
         IF (ba >= 16#41) AND (ba <= 16#5A) THEN
            ba := ba OR 16#20;
         END_IF;
         bb := CHAR_TO_BYTE(sHdr[j + 1]);
         IF ba <> bb THEN
            match := FALSE;
            EXIT;
         END_IF;
      END_FOR;

      IF match THEN
         // value starts after header name; skip optional leading spaces
         j := i + hdrLen;
         WHILE (j < UINT_TO_INT(dataLen)) AND (buf[j] = 16#20) DO
            j := j + 1;
         END_WHILE;

         keyLen := 0;
         WHILE (j < UINT_TO_INT(dataLen)) AND (keyLen < 40) DO
            ba := buf[j];
            IF (ba = 16#0D) OR (ba = 16#0A) OR (ba = 16#20) THEN
               EXIT;
            END_IF;
            keyOut[keyLen] := ba;
            keyLen := keyLen + 1;
            j := j + 1;
         END_WHILE;

         FC_WS_FindKey := keyLen;
         RETURN;
      END_IF;

      i := i + 1;
   END_WHILE;
END_FUNCTION


// --- FC_WS_BuildAccept.scl ---
FUNCTION "FC_WS_BuildAccept" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Compute Sec-WebSocket-Accept = Base64( SHA1( key + GUID ) ).
//  Writes ASCII result into accept[] and returns its length (28 for a 16-byte key).
//  RFC 6455 test: key "dGhlIHNhbXBsZSBub25jZQ==" -> "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
VAR_INPUT
   keyLen : Int;                       // length of key value in "key"
END_VAR
VAR_IN_OUT
   key    : Array[0..39] of Byte;      // client key value
   accept : Array[0..39] of Byte;      // output ASCII accept value
END_VAR
VAR_TEMP
   sGuid    : String[36];
   guidLen  : Int;
   i        : Int;
   combined : Array[0..127] of Byte;
   hash     : Array[0..19] of Byte;
   totalLen : Int;
END_VAR
BEGIN
   sGuid   := '258EAFA5-E914-47DA-95CA-C5AB0DC85B11';
   guidLen := LEN(sGuid);              // = 36

   FOR i := 0 TO keyLen - 1 DO
      combined[i] := key[i];
   END_FOR;
   FOR i := 0 TO guidLen - 1 DO
      combined[keyLen + i] := CHAR_TO_BYTE(sGuid[i + 1]);
   END_FOR;
   totalLen := keyLen + guidLen;

   "FC_WS_SHA1"(msgLen := INT_TO_UDINT(totalLen),
                data := combined,
                hash := hash);

   FC_WS_BuildAccept := "FC_WS_Base64"(msgLen := 20,
                                       inp  := hash,
                                       outp := accept);
END_FUNCTION


// --- FC_WS_ParseFrame.scl ---
FUNCTION "FC_WS_ParseFrame" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Try to decode ONE WebSocket frame starting at buf[offset].
//  "avail" = number of valid bytes available from offset onward.
//  Return code:
//     0 = incomplete, wait for more TCP data (frame fields undefined)
//     1 = one full frame decoded -> use frame.*  (frame.uiTotalLen = bytes consumed)
//     2 = protocol error / unsupported frame -> caller must close the connection
//  Supported: FIN=1, opcodes 0/1/2/8/9/10, MASK=1, length 0..125 and 126 (16-bit),
//             application payload up to 240 bytes.  64-bit length (127) is rejected.
VAR_INPUT
   offset : UInt;                      // start index inside buf
   avail  : UInt;                      // bytes available from offset
END_VAR
VAR_IN_OUT
   buf    : Array[*] of Byte;          // RX stream buffer (0-based)
   frame  : "UDT_WS_Frame";
END_VAR
VAR_TEMP
   o          : Int;                   // absolute base index (offset)
   byte0      : Byte;
   byte1      : Byte;
   len7       : Byte;
   maskStart  : Int;
   payStart   : Int;
   payLen     : Int;
   i          : Int;
   mIdx       : Int;
END_VAR
BEGIN
   FC_WS_ParseFrame := 0;
   frame.xValid := FALSE;

   IF avail < 2 THEN
      RETURN;
   END_IF;

   o     := UINT_TO_INT(offset);
   byte0 := buf[o];
   byte1 := buf[o + 1];

   frame.xFin     := (byte0 AND 16#80) = 16#80;
   frame.byOpcode := byte0 AND 16#0F;
   frame.xMasked  := (byte1 AND 16#80) = 16#80;

   len7 := byte1 AND 16#7F;

   IF len7 < 126 THEN
      payLen    := BYTE_TO_INT(len7);
      maskStart := 2;
   ELSIF len7 = 126 THEN
      IF avail < 4 THEN RETURN; END_IF;
      payLen    := BYTE_TO_INT(buf[o + 2]) * 256 + BYTE_TO_INT(buf[o + 3]);
      maskStart := 4;
   ELSE
      // 127 => 64-bit length, not supported
      FC_WS_ParseFrame := 2;
      RETURN;
   END_IF;

   IF payLen > 240 THEN
      FC_WS_ParseFrame := 2;          // oversize application payload
      RETURN;
   END_IF;

   IF frame.xMasked THEN
      IF UINT_TO_INT(avail) < maskStart + 4 THEN RETURN; END_IF;
      frame.abMaskKey[0] := buf[o + maskStart];
      frame.abMaskKey[1] := buf[o + maskStart + 1];
      frame.abMaskKey[2] := buf[o + maskStart + 2];
      frame.abMaskKey[3] := buf[o + maskStart + 3];
      payStart := maskStart + 4;
   ELSE
      // browser-to-server frames must be masked (RFC 6455 5.1)
      FC_WS_ParseFrame := 2;
      RETURN;
   END_IF;

   // wait until the whole payload is present
   IF UINT_TO_INT(avail) < payStart + payLen THEN
      RETURN;
   END_IF;

   IF payLen > 0 THEN
      FOR i := 0 TO payLen - 1 DO
         mIdx := i MOD 4;
         frame.abPayload[i] := buf[o + payStart + i] XOR frame.abMaskKey[mIdx];
      END_FOR;
   END_IF;

   frame.uiPayloadLen := INT_TO_UINT(payLen);
   frame.uiTotalLen   := INT_TO_UINT(payStart + payLen);
   frame.xValid       := TRUE;
   FC_WS_ParseFrame   := 1;
END_FUNCTION


// --- FC_WS_BuildFrame.scl ---
FUNCTION "FC_WS_BuildFrame" : UInt
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Build one unmasked server->client frame into outBuf.  Returns total length.
//  FIN=1, MASK=0.  Length 0..125 = 1 byte; 126..240 = marker 126 + 16-bit BE.
VAR_INPUT
   opcode  : Byte;                     // 16#02 binary, 16#08 close, 16#0A pong ...
   payLen  : UInt;                     // 0..240
END_VAR
VAR_IN_OUT
   payload : Array[*] of Byte;         // source payload (0-based); ignored if payLen=0
   outBuf  : Array[*] of Byte;         // destination frame (0-based)
END_VAR
VAR_TEMP
   idx : Int;
   i   : Int;
   n   : Int;
END_VAR
BEGIN
   // byte 0: FIN + opcode
   outBuf[0] := opcode OR 16#80;

   n := UINT_TO_INT(payLen);
   IF n < 126 THEN
      outBuf[1] := INT_TO_BYTE(n);
      idx := 2;
   ELSE
      outBuf[1] := 126;
      outBuf[2] := INT_TO_BYTE(n / 256);        // high byte (big-endian)
      outBuf[3] := INT_TO_BYTE(n MOD 256);      // low byte
      idx := 4;
   END_IF;

   FOR i := 0 TO n - 1 DO
      outBuf[idx + i] := payload[i];
   END_FOR;

   FC_WS_BuildFrame := INT_TO_UINT(idx + n);
END_FUNCTION


// --- FC_WS_MapInputs.scl ---
FUNCTION "FC_WS_MapInputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  UNPACK the little-endian Browser->PLC byte image into typed application data.
//  Siemens stores multi-byte numbers big-endian, the browser sends little-endian,
//  so every field is reassembled byte-by-byte and reinterpreted with the S7-1500
//  bit-preserving conversions (no AT overlays - rejected in FC temp).
//  Offsets must match UDT_App_Inputs exactly.
VAR_IN_OUT
   raw : Array[*] of Byte;             // InputsRaw (0-based, >= 39 bytes)
   app : "UDT_App_Inputs";
END_VAR
VAR_TEMP
   i   : Int;
   w   : Word;
   dw  : DWord;
END_VAR
BEGIN
   // offset 0: watchdog byte
   app.uiWatchdog_Inputs := raw[0];

   // offset 4: REAL (LE bytes -> bit pattern -> reinterpret)
   dw := BYTE_TO_DWORD(raw[4])
      OR SHL(IN := BYTE_TO_DWORD(raw[5]), N := 8)
      OR SHL(IN := BYTE_TO_DWORD(raw[6]), N := 16)
      OR SHL(IN := BYTE_TO_DWORD(raw[7]), N := 24);
   app.rSpeedSetpoint := DWORD_TO_REAL(dw);

   // offset 8: DINT
   dw := BYTE_TO_DWORD(raw[8])
      OR SHL(IN := BYTE_TO_DWORD(raw[9]),  N := 8)
      OR SHL(IN := BYTE_TO_DWORD(raw[10]), N := 16)
      OR SHL(IN := BYTE_TO_DWORD(raw[11]), N := 24);
   app.diEncoderRaw := DWORD_TO_DINT(dw);

   // offset 12: INT
   w := BYTE_TO_WORD(raw[12]) OR SHL(IN := BYTE_TO_WORD(raw[13]), N := 8);
   app.iTargetPosition := WORD_TO_INT(w);

   // offset 14: UINT
   w := BYTE_TO_WORD(raw[14]) OR SHL(IN := BYTE_TO_WORD(raw[15]), N := 8);
   app.uiCycleCount := WORD_TO_UINT(w);

   // offset 16: packed bits
   app.xStart    := (raw[16] AND 16#01) <> 0;
   app.xModeAuto := (raw[16] AND 16#02) <> 0;

   // offset 17: BYTE
   app.byStatusBits := raw[17];

   // offset 18: STRING(20) C-style, 21 bytes verbatim
   FOR i := 0 TO 20 DO
      app.sProductName[i] := BYTE_TO_CHAR(raw[18 + i]);
   END_FOR;
END_FUNCTION


// --- FC_WS_MapOutputs.scl ---
FUNCTION "FC_WS_MapOutputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.4
//  PACK typed application data into the little-endian PLC->Browser byte image.
//  Reverse of FC_WS_MapInputs. This toolchain lacks numeric->bitstring reinterpret,
//  SERIALIZE, and the single-use conversions REAL_TO_DINT/INT_TO_DINT/UINT_TO_DINT,
//  so everything is done with proven ops only:
//    * INT / UINT -> bytes via FC_U2D (INT_TO_UINT, UINT_TO_UDINT are available);
//    * DINT       -> bytes by sign-corrected MOD/DIV arithmetic;
//    * REAL       -> IEEE-754 single, mantissa extracted bit-by-bit (no Real->Int).
//  Offsets must match UDT_App_Outputs exactly.
//  NOTE: watchdog byte (offset 0) is overwritten by FB_WS_Bridge each scan.
VAR_IN_OUT
   app : "UDT_App_Outputs";
   raw : Array[*] of Byte;             // OutputsRaw (0-based, >= 59 bytes)
END_VAR
VAR_TEMP
   i    : Int;
   bOut   : Byte;
   t    : DInt;
   bb   : DInt;
   dw   : DWord;
   uiv  : UInt;
   rr   : Real;
   frac : Real;
   sgn  : DInt;
   ex   : DInt;
   mn   : DInt;
END_VAR
BEGIN
   // offset 0: watchdog ; offset 1..3: alignment padding
   #raw[0] := #app.uiWatchdog_Outputs;
   #raw[1] := 0; #raw[2] := 0; #raw[3] := 0;

   // ---- offset 4: REAL as IEEE-754 single, little-endian ----
   #rr := #app.rActualSpeed;
   IF #rr = 0.0 THEN
      #sgn := 0; #ex := 0; #mn := 0;
   ELSE
      IF #rr < 0.0 THEN #sgn := 1; #rr := #rr * (-1.0); ELSE #sgn := 0; END_IF;
      #ex := 127;
      WHILE #rr >= 2.0 DO #rr := #rr / 2.0; #ex := #ex + 1; END_WHILE;
      WHILE #rr < 1.0  DO #rr := #rr * 2.0; #ex := #ex - 1; END_WHILE;
      // 1.0 <= #rr < 2.0 ; extract 23 mantissa bits without a Real->Int conversion
      #frac := #rr - 1.0;
      #mn := 0;
      FOR #i := 1 TO 23 DO
         #frac := #frac * 2.0;
         IF #frac >= 1.0 THEN
            #mn := #mn * 2 + 1;
            #frac := #frac - 1.0;
         ELSE
            #mn := #mn * 2;
         END_IF;
      END_FOR;
      IF #ex < 1   THEN #ex := 0;   #mn := 0; END_IF;   // underflow -> 0
      IF #ex > 254 THEN #ex := 255; #mn := 0; END_IF;   // overflow  -> inf
   END_IF;
   #raw[4] := INT_TO_BYTE(DINT_TO_INT(#mn MOD 256));
   #raw[5] := INT_TO_BYTE(DINT_TO_INT((#mn / 256) MOD 256));
   #raw[6] := INT_TO_BYTE(DINT_TO_INT((#ex MOD 2) * 128 + (#mn / 65536)));
   #raw[7] := INT_TO_BYTE(DINT_TO_INT(#sgn * 128 + #ex / 2));

   // ---- offset 8: DINT, little-endian (sign-corrected byte extraction) ----
   #t := #app.diEncoderFeedback;
   #bb := #t MOD 256; IF #bb < 0 THEN #bb := #bb + 256; END_IF; #raw[8]  := INT_TO_BYTE(DINT_TO_INT(#bb)); #t := (#t - #bb) / 256;
   #bb := #t MOD 256; IF #bb < 0 THEN #bb := #bb + 256; END_IF; #raw[9]  := INT_TO_BYTE(DINT_TO_INT(#bb)); #t := (#t - #bb) / 256;
   #bb := #t MOD 256; IF #bb < 0 THEN #bb := #bb + 256; END_IF; #raw[10] := INT_TO_BYTE(DINT_TO_INT(#bb)); #t := (#t - #bb) / 256;
   #bb := #t MOD 256; IF #bb < 0 THEN #bb := #bb + 256; END_IF; #raw[11] := INT_TO_BYTE(DINT_TO_INT(#bb));

   // ---- offset 12: INT, little-endian (via FC_U2D on the 16-bit pattern) ----
   #uiv := INT_TO_UINT(#app.iActualPosition);
   #dw  := "FC_U2D"(UINT_TO_UDINT(#uiv));
   #raw[12] := DWORD_TO_BYTE(#dw AND 16#FF);
   #raw[13] := DWORD_TO_BYTE(SHR(IN := #dw, N := 8) AND 16#FF);

   // ---- offset 14: UINT, little-endian ----
   #dw := "FC_U2D"(UINT_TO_UDINT(#app.uiErrorID));
   #raw[14] := DWORD_TO_BYTE(#dw AND 16#FF);
   #raw[15] := DWORD_TO_BYTE(SHR(IN := #dw, N := 8) AND 16#FF);

   // ---- offset 16: packed bits ----
   #bOut := 0;
   IF #app.xLightWarning THEN #bOut := #bOut OR 16#01; END_IF;
   IF #app.xMotorRunning THEN #bOut := #bOut OR 16#02; END_IF;
   #raw[16] := #bOut;

   // ---- offset 17: BYTE ----
   #raw[17] := #app.byErrorCode;

   // ---- offset 18: STRING(40) C-style, 41 bytes verbatim ----
   FOR #i := 0 TO 40 DO
      #raw[18 + #i] := CHAR_TO_BYTE(#app.sLogMessage[#i]);
   END_FOR;
END_FUNCTION


// --- FC_WS_Num5 / FC_WS_Hex4 / FC_WS_Trace - event-trace helpers ---
FUNCTION "FC_WS_Num5" : String[8]
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Render a UInt as exactly 5 decimal digits ('00155').
VAR_INPUT
   n : UInt;
END_VAR
VAR_TEMP
   v : DInt;
   s : String[8];
END_VAR
BEGIN
   v := UINT_TO_DINT(n);
   s := '00000';
   s[1] := BYTE_TO_CHAR(INT_TO_BYTE(48 + DINT_TO_INT((v / 10000) MOD 10)));
   s[2] := BYTE_TO_CHAR(INT_TO_BYTE(48 + DINT_TO_INT((v / 1000) MOD 10)));
   s[3] := BYTE_TO_CHAR(INT_TO_BYTE(48 + DINT_TO_INT((v / 100) MOD 10)));
   s[4] := BYTE_TO_CHAR(INT_TO_BYTE(48 + DINT_TO_INT((v / 10) MOD 10)));
   s[5] := BYTE_TO_CHAR(INT_TO_BYTE(48 + DINT_TO_INT(v MOD 10)));
   FC_WS_Num5 := s;
END_FUNCTION


FUNCTION "FC_WS_Hex4" : String[8]
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Render a Word as 4 hex characters ('80C4').
VAR_INPUT
   w : Word;
END_VAR
VAR_TEMP
   u   : UDInt;
   div : UDInt;
   d   : Int;
   i   : Int;
   s   : String[8];
END_VAR
BEGIN
   u := WORD_TO_UDINT(w);
   s := '0000';
   div := 4096;
   FOR i := 1 TO 4 DO
      d := UDINT_TO_INT((u / div) MOD 16);
      IF d < 10 THEN
         s[i] := BYTE_TO_CHAR(INT_TO_BYTE(48 + d));
      ELSE
         s[i] := BYTE_TO_CHAR(INT_TO_BYTE(55 + d));
      END_IF;
      div := div / 16;
   END_FOR;
   FC_WS_Hex4 := s;
END_FUNCTION


FUNCTION "FC_WS_Trace" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Push one entry into the rolling 16-slot event trace in UDT_WS_Status.
//  Watch WsStatus.asTrace online: newest = asTrace[(uiTraceIdx - 1) MOD 16].
//  Only EVENTS are traced (transitions, errors) - never per-scan states, so
//  the log cannot flood.
VAR_INPUT
   msg : String;                 // note: FC string inputs must be length-less
END_VAR
VAR_IN_OUT
   st : "UDT_WS_Status";
END_VAR
VAR_TEMP
   idx : Int;
END_VAR
BEGIN
   idx := UINT_TO_INT(st.uiTraceIdx MOD UINT#16);
   st.asTrace[idx] := msg;
   st.uiTraceIdx := st.uiTraceIdx + UINT#1;
END_FUNCTION


// --- FB_WS_Server.scl  (V3 - configured-connection transport) ---
FUNCTION_BLOCK "FB_WS_Server"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.3
//  RFC 6455 WebSocket server for S7-1500 / PLCSIM Advanced - V3 transport.
//
//  TRANSPORT (rewritten): the TCP endpoint is a CONFIGURED connection created in
//  the device configuration (passive / server, local port 8082). It is driven by
//  the CLASSIC basic pair TRCV + TSEND referenced by ID - NO compact (_C) blocks,
//  no TCON_Configured descriptor, no programmatic TCON / TDISCON. A configured
//  connection is established by the CPU firmware on its own; the basic blocks
//  merely ride it. Proven by the standalone echo test (TCP_Echo_Test.scl +
//  tcp_echo_probe.py: 5/5 echoes, ~1 ms RTT), while every _C variant failed:
//    * TRCV_C's internal connection management held a PERMANENT 16#80C4 on
//      PLCSIM even as the only block on the connection, freezing the handshake;
//    * TSEND_C additionally fought TRCV_C over establishment (7001 vs 80C4);
//    * a programmatic passive TCON_IP_v4 does not co-exist with a configured
//      connection on the same port at all (7000/8085).
//
//    * config.connectionId MUST equal the "Local ID" of the configured connection
//      (TIA default for the first connection is 16#0100).
//    * TRCV receives ad-hoc (LEN 0, ADHOC := TRUE) into rxBuf; chunks are
//      accumulated in streamBuf, an RX error must NOT wipe it mid-request.
//    * TSEND REQ is pulsed via txReq so each frame gets a clean rising edge.
//      One send is in flight at a time.
//
//  Reused unchanged: FC_WS_FindKey + FC_WS_BuildAccept (handshake),
//                    FC_WS_ParseFrame + FC_WS_BuildFrame (frame codec).
VAR_INPUT
   Enable  : Bool;
   config  : "UDT_WS_Config";
   sendReq : Bool;                     // hold TRUE to transmit txPayload[0..txLen-1]
   txLen   : UInt;                     // application payload length to send (0..240)
END_VAR
VAR_OUTPUT
   Running         : Bool;
   ClientConnected : Bool;
   HandshakeDone   : Bool;
   NewInputData    : Bool;             // TRUE for exactly one scan after a full frame
   rxLen           : UInt;             // length of last received application payload
   Error           : Bool;
   Busy            : Bool;
END_VAR
VAR_IN_OUT
   txPayload : Array[*] of Byte;       // application bytes to send   (OutputsRaw)
   rxPayload : Array[*] of Byte;       // last received app bytes     (InputsRaw)
   status    : "UDT_WS_Status";
END_VAR
VAR
   // --- OUC blocks over the CONFIGURED connection ---
   // Classic basic pair: neither block manages the connection - the firmware
   // establishes the configured connection by itself, TRCV/TSEND just ride it
   // by ID. Compact (_C) blocks are deliberately NOT used: TRCV_C's internal
   // connection management held a permanent 80C4 on PLCSIM (even alone on the
   // connection), which is what froze the handshake.
   instTrcv    : TRCV;
   instTsend   : TSEND;

   // --- state machine ---
   state       : UInt := 0;

   // --- RX ---
   rxBuf       : Array[0..1459] of Byte;   // TRCV ad-hoc target
   streamBuf   : Array[0..2047] of Byte;   // accumulated stream
   streamLen   : UInt;

   // --- TX (one send in flight) ---
   txFrameBuf  : Array[0..511] of Byte;    // built outgoing frame
   txFrameLen  : UInt;
   txReq       : Bool;                     // TSEND REQ (held until DONE)
   txPurpose   : UInt;                     // 0 none, 1 handshake, 2 pong, 3 app, 4 close, 5 diag
   txHoldScans : UInt;                     // scans the current send has been pending (stall watchdog)
   txGap       : Bool;                     // force ONE REQ=0 scan after each send so TSEND re-arms its
                                           // rising edge (under continuous traffic REQ never fell -> 7000)
   pendClose   : Bool;
   pendPong    : Bool;
   pongLen     : UInt;
   pongBuf     : Array[0..127] of Byte;
   hsStuckCnt  : UInt;                     // scans stuck in ST_HS_RECV with bytes but no terminator

   // --- handshake ---
   keyBuf      : Array[0..39] of Byte;
   acceptBuf   : Array[0..39] of Byte;
   frame       : "UDT_WS_Frame";
END_VAR
VAR_TEMP
   trcvNdr  : Bool;
   trcvBusy : Bool;
   trcvError: Bool;
   sendDone : Bool;
   sendBusy : Bool;
   sendError: Bool;
   rcvdLen     : UDInt;
   j           : Int;
   n           : Int;
   parseOffset : Int;
   code        : Int;
   hdrEnd      : Int;
   keyLen      : Int;
   acceptLen   : Int;
   respLen     : Int;
   sLine       : String[64];
   more        : Bool;
   dHi         : Int;
   dLo         : Int;
   byT         : Byte;
END_VAR
CONST
   ST_IDLE       := 0;
   ST_HS_RECV    := 20;
   ST_HS_SEND    := 30;
   ST_CONNECTED  := 40;
   ST_DISCONNECT := 60;
   ST_ERR        := 255;
END_CONST
BEGIN
   NewInputData := FALSE;
   Error := FALSE;

   // ---- disable: drop the session and hold in IDLE ----
   IF NOT Enable THEN
      state := ST_IDLE;
      streamLen := 0;
      txReq := FALSE;
      txPurpose := 0;
      pendClose := FALSE;
      pendPong := FALSE;
      HandshakeDone := FALSE;
      ClientConnected := FALSE;
      status.xHandshakeDone := FALSE;
      status.xClientConnected := FALSE;
      status.xTcpConnected := FALSE;
   END_IF;

   // =====================================================================
   //  RECEIVE - basic TRCV, ad-hoc mode, configured connection by ID.
   //  Exactly the pattern proven by the standalone echo test.
   // =====================================================================
   status.uiLastOp := 2;
   instTrcv(EN_R     := Enable,
            ID       := config.connectionId,
            LEN      := 0,               // ad-hoc: take whatever has arrived
            ADHOC    := TRUE,
            DATA     := rxBuf,
            NDR      => trcvNdr,
            BUSY     => trcvBusy,
            ERROR    => trcvError,
            STATUS   => status.wTrcvStatus,
            RCVD_LEN => rcvdLen);

   IF Enable AND trcvError THEN
      status.udiTrcvErrCnt := status.udiTrcvErrCnt + 1;
      IF status.wTrcvStatus <> status.wLastTrcvErr THEN
         // trace only on a CHANGED error code, so the idle 80C4 logs once
         "FC_WS_Trace"(msg := CONCAT(IN1 := 'RX ERR=', IN2 := "FC_WS_Hex4"(w := status.wTrcvStatus)), st := status);
      END_IF;
      status.wLastTrcvErr  := status.wTrcvStatus;    // latch the code
      IF (state = ST_CONNECTED) OR (state = ST_HS_SEND) THEN
         // an established client dropped / reset -> recycle the session
         status.udiTransportErr := status.udiTransportErr + 1;
         status.uiDiscFrom := state;
         status.uiDiscReason := 1;
         state := ST_DISCONNECT;
      END_IF;
      // Handshake phase (ST_IDLE / ST_HS_RECV): a transient RX error while the
      // browser's HTTP request is still arriving in ad-hoc chunks must NOT wipe
      // streamBuf - wiping was destroying the partly-received request between
      // chunks, so the full CR LF CR LF terminator was never present in one
      // scan and the FB froze in ST_HS_RECV. Keep the bytes, keep searching.
   END_IF;

   // Accumulate on NDR regardless of a coincident transient error flag: DONE and
   // ERROR are mutually exclusive per call, so a separate IF never mixes them.
   IF Enable AND trcvNdr AND (rcvdLen > 0) THEN
      status.xTcpConnected := TRUE;
      status.udiRxBytes := status.udiRxBytes + rcvdLen;
      FOR j := 0 TO UDINT_TO_INT(rcvdLen) - 1 DO
         IF streamLen < 2048 THEN
            streamBuf[streamLen] := rxBuf[j];
            streamLen := streamLen + 1;
         ELSE
            status.xRxOverflow := TRUE;
         END_IF;
      END_FOR;
      status.uiStreamLen := streamLen;
      "FC_WS_Trace"(msg := CONCAT(IN1 := 'RX chunk L=', IN2 := "FC_WS_Num5"(n := streamLen)), st := status);
   END_IF;

   // =====================================================================
   //  STATE MACHINE - consume streamBuf, decide what to transmit
   //  NOTE: the branch labels are NUMERIC LITERALS on purpose. TIA silently
   //  mis-resolves local CONST identifiers used as CASE labels in blocks
   //  generated from external sources: 'state := ST_HS_RECV' stored 20, yet
   //  the branch 'ST_HS_RECV:' never matched (proven by trace + counters).
   //  Literal labels are matched correctly (the two other CASEs in this FB
   //  always used literals and always worked). Do NOT "clean this up".
   // =====================================================================
   CASE state OF

   0:   // ST_IDLE
      ClientConnected := FALSE;
      HandshakeDone := FALSE;
      status.xTcpConnected := FALSE;
      status.xHandshakeDone := FALSE;
      status.xClientConnected := FALSE;
      streamLen := 0;
      txReq := FALSE;
      txPurpose := 0;
      hsStuckCnt := 0;
      IF Enable THEN
         state := ST_HS_RECV;
         "FC_WS_Trace"(msg := 'IDLE->HS_RECV', st := status);
      END_IF;

   20:  // ST_HS_RECV
      // accumulate raw HTTP bytes until CR LF CR LF, then answer with 101
      status.udiHsRecvScans := status.udiHsRecvScans + 1;
      hdrEnd := -1;
      IF streamLen >= 4 THEN
         FOR j := 0 TO UINT_TO_INT(streamLen) - 4 DO
            IF (streamBuf[j] = 16#0D) AND (streamBuf[j + 1] = 16#0A)
               AND (streamBuf[j + 2] = 16#0D) AND (streamBuf[j + 3] = 16#0A) THEN
               hdrEnd := j + 4;
               EXIT;
            END_IF;
         END_FOR;
      END_IF;

      IF hdrEnd >= 0 THEN
         hsStuckCnt := 0;
         status.udiHdrFound := status.udiHdrFound + 1;
         "FC_WS_Trace"(msg := CONCAT(IN1 := 'HDR end=', IN2 := "FC_WS_Num5"(n := INT_TO_UINT(hdrEnd))), st := status);
         keyLen := "FC_WS_FindKey"(dataLen := streamLen, buf := streamBuf, keyOut := keyBuf);
         IF keyLen > 0 THEN
            "FC_WS_Trace"(msg := CONCAT(IN1 := 'KEY len=', IN2 := "FC_WS_Num5"(n := INT_TO_UINT(keyLen))), st := status);
            acceptLen := "FC_WS_BuildAccept"(keyLen := keyLen, key := keyBuf, accept := acceptBuf);
            // build HTTP 101 response into txFrameBuf
            respLen := 0;
            sLine := 'HTTP/1.1 101 Switching Protocols$R$L';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            sLine := 'Upgrade: websocket$R$L';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            sLine := 'Connection: Upgrade$R$L';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            sLine := 'Sec-WebSocket-Accept: ';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            FOR n := 0 TO acceptLen - 1 DO txFrameBuf[respLen] := acceptBuf[n]; respLen := respLen + 1; END_FOR;
            txFrameBuf[respLen] := 16#0D; respLen := respLen + 1;
            txFrameBuf[respLen] := 16#0A; respLen := respLen + 1;
            txFrameBuf[respLen] := 16#0D; respLen := respLen + 1;
            txFrameBuf[respLen] := 16#0A; respLen := respLen + 1;
            txFrameLen := INT_TO_UINT(respLen);
            streamLen := 0;                  // handshake consumed the buffered request
            status.uiStreamLen := 0;
            txPurpose := 1;                  // handshake response
            txReq := TRUE;
            status.udiHsSent := status.udiHsSent + 1;
            "FC_WS_Trace"(msg := CONCAT(IN1 := '101 QUEUED L=', IN2 := "FC_WS_Num5"(n := txFrameLen)), st := status);
            state := ST_HS_SEND;
         ELSE
            status.udiProtocolErrors := status.udiProtocolErrors + 1;
            status.uiDiscFrom := state;
            status.uiDiscReason := 2;   // header complete but no Sec-WebSocket-Key
            "FC_WS_Trace"(msg := 'KEY MISSING -> DISC', st := status);
            state := ST_DISCONNECT;
         END_IF;
      ELSIF streamLen > 1200 THEN
         // No CR LF CR LF within a plausible HTTP request size: the buffer is
         // holding stale bytes from an earlier connection that we chose not to
         // wipe on a transient RX error. Resync so a fresh handshake can land.
         streamLen := 0;
         status.uiStreamLen := 0;
         status.udiStaleResync := status.udiStaleResync + 1;
      ELSIF streamLen > 0 THEN
         // Stuck guard / self-report: bytes are here but the terminator search
         // failed for ~800 consecutive scans. Send ONE plain-ASCII diagnostic
         // line over the socket - the probe prints whatever arrives before its
         // timeout, so this is visible on the PC without TIA:
         //   WSDIAG L=nnnnn T=hhhhhhhh   (L = streamLen, T = last 4 buffer
         //   bytes in hex; a well-formed request must end T=0D0A0D0A).
         // Its very arrival also proves this branch executes and TX works.
         IF hsStuckCnt < 65000 THEN
            hsStuckCnt := hsStuckCnt + 1;
         END_IF;
         IF (hsStuckCnt = 800) AND NOT txReq THEN
            respLen := 0;
            sLine := 'WSDIAG L=';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            n := UINT_TO_INT(streamLen);
            txFrameBuf[respLen] := INT_TO_BYTE(48 + (n / 10000) MOD 10); respLen := respLen + 1;
            txFrameBuf[respLen] := INT_TO_BYTE(48 + (n / 1000) MOD 10);  respLen := respLen + 1;
            txFrameBuf[respLen] := INT_TO_BYTE(48 + (n / 100) MOD 10);   respLen := respLen + 1;
            txFrameBuf[respLen] := INT_TO_BYTE(48 + (n / 10) MOD 10);    respLen := respLen + 1;
            txFrameBuf[respLen] := INT_TO_BYTE(48 + (n MOD 10));         respLen := respLen + 1;
            sLine := ' T=';
            FOR n := 1 TO LEN(sLine) DO txFrameBuf[respLen] := CHAR_TO_BYTE(sLine[n]); respLen := respLen + 1; END_FOR;
            FOR j := 0 TO 3 DO
               IF UINT_TO_INT(streamLen) >= 4 THEN
                  byT := streamBuf[UINT_TO_INT(streamLen) - 4 + j];
               ELSE
                  byT := 16#00;
               END_IF;
               dHi := BYTE_TO_INT(byT) / 16;
               dLo := BYTE_TO_INT(byT) MOD 16;
               IF dHi < 10 THEN txFrameBuf[respLen] := INT_TO_BYTE(48 + dHi);
               ELSE             txFrameBuf[respLen] := INT_TO_BYTE(55 + dHi); END_IF;
               respLen := respLen + 1;
               IF dLo < 10 THEN txFrameBuf[respLen] := INT_TO_BYTE(48 + dLo);
               ELSE             txFrameBuf[respLen] := INT_TO_BYTE(55 + dLo); END_IF;
               respLen := respLen + 1;
            END_FOR;
            txFrameBuf[respLen] := 16#0D; respLen := respLen + 1;
            txFrameBuf[respLen] := 16#0A; respLen := respLen + 1;
            txFrameLen := INT_TO_UINT(respLen);
            txPurpose := 5;               // diagnostic self-report, stay in ST_HS_RECV
            txReq := TRUE;
            "FC_WS_Trace"(msg := 'WSDIAG QUEUED', st := status);
         END_IF;
      END_IF;

   30:  // ST_HS_SEND
      // the TRANSMIT section drives TSEND; on DONE(purpose 1) -> ST_CONNECTED
      ;

   40:  // ST_CONNECTED
      // ---- parse every complete frame currently in the stream ----
      parseOffset := 0;
      more := TRUE;
      WHILE more AND (parseOffset < UINT_TO_INT(streamLen)) DO
         code := "FC_WS_ParseFrame"(offset := INT_TO_UINT(parseOffset),
                                    avail := INT_TO_UINT(UINT_TO_INT(streamLen) - parseOffset),
                                    buf := streamBuf, frame := frame);
         IF code = 1 THEN
            CASE BYTE_TO_INT(frame.byOpcode) OF
               1, 2:   // text / binary application data
                  rxLen := frame.uiPayloadLen;
                  FOR j := 0 TO UINT_TO_INT(frame.uiPayloadLen) - 1 DO
                     rxPayload[j] := frame.abPayload[j];
                  END_FOR;
                  NewInputData := TRUE;
                  status.udiRxFrames := status.udiRxFrames + 1;
                  status.uiLastRxPayload := frame.uiPayloadLen;
               8:      // close
                  pendClose := TRUE;
                  more := FALSE;
               9:      // ping -> queue pong with same payload
                  pendPong := TRUE;
                  pongLen := frame.uiPayloadLen;
                  FOR j := 0 TO UINT_TO_INT(frame.uiPayloadLen) - 1 DO
                     pongBuf[j] := frame.abPayload[j];
                  END_FOR;
               10:     // pong -> ignore
                  ;
            END_CASE;
            parseOffset := parseOffset + UINT_TO_INT(frame.uiTotalLen);
         ELSIF code = 0 THEN
            more := FALSE;               // partial frame, wait for more data
         ELSE
            status.udiProtocolErrors := status.udiProtocolErrors + 1;
            pendClose := TRUE;           // protocol error -> close politely
            more := FALSE;
         END_IF;
      END_WHILE;

      // ---- drop consumed bytes, keep the remainder ----
      IF parseOffset > 0 THEN
         n := UINT_TO_INT(streamLen) - parseOffset;
         FOR j := 0 TO n - 1 DO
            streamBuf[j] := streamBuf[parseOffset + j];
         END_FOR;
         streamLen := INT_TO_UINT(n);
         status.uiStreamLen := streamLen;
      END_IF;

      // ---- queue the next outgoing frame if the sender is free ----
      //  txGap forces one REQ=0 scan between sends so TSEND sees a fresh rising
      //  edge; without it, back-to-back frames hold REQ high and TSEND sits at 7000.
      IF NOT txReq AND NOT txGap THEN
         IF pendClose THEN
            txFrameLen := "FC_WS_BuildFrame"(opcode := 16#08, payLen := 0,
                                             payload := pongBuf, outBuf := txFrameBuf);
            txPurpose := 4;
            txReq := TRUE;
         ELSIF pendPong THEN
            txFrameLen := "FC_WS_BuildFrame"(opcode := 16#0A, payLen := pongLen,
                                             payload := pongBuf, outBuf := txFrameBuf);
            pendPong := FALSE;
            txPurpose := 2;
            txReq := TRUE;
         ELSIF sendReq AND (txLen > 0) THEN
            txFrameLen := "FC_WS_BuildFrame"(opcode := 16#02, payLen := txLen,
                                             payload := txPayload, outBuf := txFrameBuf);
            status.uiLastTxPayload := txLen;
            status.udiTxQueued := status.udiTxQueued + 1;   // trigger fired (compare vs udiTxFrames = completed)
            txPurpose := 3;
            txReq := TRUE;
         END_IF;
      END_IF;

   60:  // ST_DISCONNECT
      status.uiLastOp := 4;
      "FC_WS_Trace"(msg := CONCAT(IN1 := 'DISC reason=', IN2 := "FC_WS_Num5"(n := status.uiDiscReason)), st := status);
      HandshakeDone := FALSE;
      ClientConnected := FALSE;
      status.xHandshakeDone := FALSE;
      status.xClientConnected := FALSE;
      status.xTcpConnected := FALSE;
      pendClose := FALSE;
      pendPong := FALSE;
      txReq := FALSE;
      txPurpose := 0;
      hsStuckCnt := 0;
      streamLen := 0;
      status.uiStreamLen := 0;
      status.xRxOverflow := FALSE;
      status.udiReconnects := status.udiReconnects + 1;
      // Configured connection stays owned by the CPU firmware. No TDISCON:
      // just drop the session and wait for the next client handshake.
      IF Enable THEN
         state := ST_HS_RECV;
      ELSE
         state := ST_IDLE;
      END_IF;

   255: // ST_ERR
      Error := TRUE;
      IF NOT Enable THEN state := ST_IDLE; END_IF;

   END_CASE;

   // =====================================================================
   //  TRANSMIT - basic TSEND on the same configured connection by ID.
   //  One send in flight; REQ is pulsed via txReq for a clean rising edge.
   // =====================================================================
   status.uiLastOp := 3;
   instTsend(REQ     := txReq,
             ID      := config.connectionId,
             LEN     := UINT_TO_UDINT(txFrameLen),
             DATA    := txFrameBuf,
             DONE    => sendDone,
             BUSY    => sendBusy,
             ERROR   => sendError,
             STATUS  => status.wTsendStatus);

   IF txReq AND sendDone THEN
      txHoldScans := 0;
      txReq := FALSE;
      txGap  := TRUE;          // insert one REQ=0 scan before the next send re-arms TSEND
      CASE txPurpose OF
         1:  // handshake response sent -> link is up
            HandshakeDone := TRUE;
            ClientConnected := TRUE;
            status.xHandshakeDone := TRUE;
            status.xClientConnected := TRUE;
            "FC_WS_Trace"(msg := 'TX 101 OK -> CONNECTED', st := status);
            state := ST_CONNECTED;
         3:  // application frame sent
            status.udiTxFrames := status.udiTxFrames + 1;
         4:  // close frame sent -> recycle the session
            status.uiDiscFrom := state;
            status.uiDiscReason := 4;
            "FC_WS_Trace"(msg := 'TX CLOSE OK -> DISC', st := status);
            state := ST_DISCONNECT;
         5:  // diagnostic self-report sent -> stay put
            "FC_WS_Trace"(msg := 'TX WSDIAG OK', st := status);
      END_CASE;
      txPurpose := 0;
   ELSIF txReq AND sendError THEN
      txHoldScans := 0;
      txReq := FALSE;
      txPurpose := 0;
      status.udiTransportErr := status.udiTransportErr + 1;
      status.wLastTsendErr := status.wTsendStatus;   // latch the TX error code
      status.uiDiscFrom := state;
      status.uiDiscReason := 3;
      "FC_WS_Trace"(msg := CONCAT(IN1 := 'TX ERR=', IN2 := "FC_WS_Hex4"(w := status.wTsendStatus)), st := status);
      state := ST_DISCONNECT;
   ELSIF txReq THEN
      // send still pending (neither DONE nor ERROR). Watch for a wedge: a TSEND
      // that never completes would leave txReq stuck TRUE and block every later
      // frame. Track how long it has been held; if it exceeds the threshold,
      // force-abort so RX can resume and latch WHY (status code) for diagnosis.
      txHoldScans := txHoldScans + 1;
      IF txHoldScans > status.uiTxMaxHold THEN
         status.uiTxMaxHold := txHoldScans;
      END_IF;
      IF txHoldScans > 20 THEN
         status.udiTxWedged := status.udiTxWedged + 1;
         status.wTxWedgedStatus := status.wTsendStatus;
         "FC_WS_Trace"(msg := CONCAT(IN1 := 'TX WEDGE p=', IN2 := "FC_WS_Num5"(n := txPurpose)), st := status);
         txReq := FALSE;
         txGap := TRUE;         // also re-arm after an aborted wedge
         txPurpose := 0;
         txHoldScans := 0;
      END_IF;
   ELSE
      txHoldScans := 0;
      txGap := FALSE;           // a REQ=0 scan has now reached TSEND -> allow the next send
   END_IF;

   // ---- ground-truth taps: real streamLen and the head of streamBuf ----
   status.uiStreamLenLive := streamLen;
   FOR j := 0 TO 31 DO
      IF j < UINT_TO_INT(streamLen) THEN
         status.abStreamHead[j] := streamBuf[j];
      ELSE
         status.abStreamHead[j] := 16#00;
      END_IF;
   END_FOR;

   status.uiState := state;
   Running := Enable AND (state <> ST_ERR);
   Busy := (state <> ST_IDLE) AND (state <> ST_CONNECTED);
END_FUNCTION_BLOCK


// --- FB_WS_Bridge.scl ---
FUNCTION_BLOCK "FB_WS_Bridge"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
//  Top-level bridge. Owns the WebSocket engine (FB_WS_Server) and moves two RAW
//  BYTE IMAGES between the browser and the PLC, sized AUTOMATICALLY from the arrays
//  you pass (UPPER_BOUND) - there is no hard-coded payload length anywhere.
//
//    OutRaw : PLC -> Browser image. Byte 0 is a watchdog this block cycles while
//             linked; bytes 1..N you fill (typically via a generated pack FC).
//    InRaw  : Browser -> PLC image. Byte 0 is the browser's watchdog, supervised
//             for liveness -> WatchdogError.
//
//  To change the dataset you only resize these two arrays (and regenerate the
//  matching struct + pack/unpack source from the webpage). This block, the engine
//  and the crypto/codec never change.
//
//  Both arrays MUST be 0-based (Array[0..N]) - the engine indexes them from 0.
//  Diagnostics live in the static "diag" (watch "DB_WS_Bridge".diag online).
//  Call from a cyclic OB; OB1 is fine, a 10 ms cyclic interrupt (OB30) is steadier.
VAR_INPUT
   Enable        : Bool;
   ConnectionID  : CONN_OUC := 16#0100;   // = "Local ID" of the configured TCP connection
   WatchdogScans : UInt     := 100;       // scans w/o incoming watchdog change -> WatchdogError
END_VAR
VAR_OUTPUT
   Running         : Bool;
   ClientConnected : Bool;
   HandshakeDone   : Bool;
   NewInputData    : Bool;   // TRUE for exactly one scan after a fresh input image
   WatchdogError   : Bool;
   State           : UInt;
   TxSize          : UInt;   // bytes shipped per output frame (= size of OutRaw)
   RxSize          : UInt;   // bytes in the last received input frame
   Error           : Bool;
END_VAR
VAR_IN_OUT
   OutRaw : Array[*] of Byte;   // PLC -> Browser image (0-based, any length)
   InRaw  : Array[*] of Byte;   // Browser -> PLC image (0-based, any length)
END_VAR
VAR
   instServer : "FB_WS_Server";
   diag       : "UDT_WS_Status";       // live diagnostics (watch this online)
   cfg        : "UDT_WS_Config";
   wdInLast   : Byte;
   wdStable   : UInt;
   outWdCount : Int;
   srvRxLen   : UInt;
END_VAR
VAR_TEMP
   linked : Bool;
   outLen : UInt;
END_VAR
BEGIN
   cfg.connectionId := ConnectionID;

   // ---- transmit length = size of the OutRaw array (auto, "by DB size") ----
   outLen := INT_TO_UINT(DINT_TO_INT(UPPER_BOUND(ARR := OutRaw, DIM := 1)) + 1);
   TxSize := outLen;

   // ---- cycle the outgoing watchdog byte while linked (last scan's link state) ----
   linked := instServer.HandshakeDone;
   IF linked AND (outLen > 0) THEN
      outWdCount := (outWdCount + 1) MOD 255;
      OutRaw[0] := INT_TO_BYTE(outWdCount);
   END_IF;

   // ---- run the WebSocket engine (level-triggered send while linked) ----
   instServer(Enable    := Enable,
              config    := cfg,
              sendReq   := linked,
              txLen     := outLen,
              txPayload := OutRaw,
              rxPayload := InRaw,
              status    := diag,
              Running         => Running,
              ClientConnected => ClientConnected,
              HandshakeDone   => HandshakeDone,
              NewInputData    => NewInputData,
              rxLen           => srvRxLen,
              Error           => Error);
   RxSize := srvRxLen;

   // ---- incoming watchdog supervision (scan-count based) ----
   IF InRaw[0] <> wdInLast THEN
      wdInLast := InRaw[0];
      diag.byLastWatchdogIn := wdInLast;
      diag.udiWatchdogChanges := diag.udiWatchdogChanges + 1;
      wdStable := 0;
   ELSIF HandshakeDone THEN
      IF wdStable < WatchdogScans THEN wdStable := wdStable + 1; END_IF;
   END_IF;
   WatchdogError := HandshakeDone AND (wdStable >= WatchdogScans);
   diag.xWatchdogError := WatchdogError;

   State := diag.uiState;
END_FUNCTION_BLOCK


// --- DB_WS_Output.scl ---
DATA_BLOCK "DB_WS_Output"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 1.0
//  PLC -> Browser data. Optimized access is OFF so the raw byte image is
//  observable and matches the browser wire layout for debugging.
//    Raw : the wire image the bridge ships (byte 0 = watchdog, managed by the FB).
//    App : typed view; FC_WS_MapOutputs packs App -> Raw (little-endian).
//  REPLACE 'Raw' size + 'App' type with the source the webpage generates for your
//  OUTPUT dataset. The bridge auto-sizes to whatever length 'Raw' has.
   STRUCT
      Raw : Array[0..58] of Byte;        // wire image (59 B for the example config)
      App : "UDT_App_Outputs";
   END_STRUCT;
BEGIN
END_DATA_BLOCK


// --- DB_WS_Input.scl ---
DATA_BLOCK "DB_WS_Input"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 1.0
//  Browser -> PLC data.
//    Raw : the wire image the bridge receives (byte 0 = browser watchdog).
//    App : typed view; FC_WS_MapInputs unpacks Raw -> App (little-endian).
//  REPLACE 'Raw' size + 'App' type with the webpage-generated INPUT source.
   STRUCT
      Raw : Array[0..38] of Byte;        // wire image (39 B for the example config)
      App : "UDT_App_Inputs";
   END_STRUCT;
BEGIN
END_DATA_BLOCK


// --- FC_WS_SelfTest.scl ---
FUNCTION "FC_WS_SelfTest" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Offline unit tests for the crypto/codec layer. Call once from a watch table /
//  test OB and inspect the outputs, BEFORE any network test. Returns TRUE only if
//  every sub-test passes.
VAR_OUTPUT
   sha1Ok    : Bool;                   // SHA1("abc") vector
   acceptOk  : Bool;                   // RFC 6455 accept-key vector
   frameOk   : Bool;                   // masked-frame parse roundtrip
   buildOk   : Bool;                   // 16-bit length frame header
END_VAR
VAR_TEMP
   msg      : Array[0..15] of Byte;
   hash     : Array[0..19] of Byte;
   expSha   : Array[0..19] of Byte;
   key      : Array[0..39] of Byte;
   accept   : Array[0..39] of Byte;
   sKey     : String[30];
   sExp     : String[30];
   aLen     : Int;
   i        : Int;
   ok       : Bool;
   // frame test
   fbuf     : Array[0..15] of Byte;
   frame    : "UDT_WS_Frame";
   code     : Int;
   // build test
   pl       : Array[0..255] of Byte;
   obuf     : Array[0..511] of Byte;
   flen     : UInt;
END_VAR
BEGIN
   // ---------- 1) SHA1("abc") ----------
   msg[0] := 16#61; msg[1] := 16#62; msg[2] := 16#63;       // "abc"
   "FC_WS_SHA1"(msgLen := 3, data := msg, hash := hash);
   expSha[0]:=16#A9; expSha[1]:=16#99; expSha[2]:=16#3E; expSha[3]:=16#36;
   expSha[4]:=16#47; expSha[5]:=16#06; expSha[6]:=16#81; expSha[7]:=16#6A;
   expSha[8]:=16#BA; expSha[9]:=16#3E; expSha[10]:=16#25; expSha[11]:=16#71;
   expSha[12]:=16#78; expSha[13]:=16#50; expSha[14]:=16#C2; expSha[15]:=16#6C;
   expSha[16]:=16#9C; expSha[17]:=16#D0; expSha[18]:=16#D8; expSha[19]:=16#9D;
   ok := TRUE;
   FOR i := 0 TO 19 DO
      IF hash[i] <> expSha[i] THEN ok := FALSE; END_IF;
   END_FOR;
   sha1Ok := ok;

   // ---------- 2) RFC 6455 accept key ----------
   sKey := 'dGhlIHNhbXBsZSBub25jZQ==';
   FOR i := 1 TO LEN(sKey) DO key[i - 1] := CHAR_TO_BYTE(sKey[i]); END_FOR;
   aLen := "FC_WS_BuildAccept"(keyLen := LEN(sKey), key := key, accept := accept);
   sExp := 's3pPLMBiTxaQ9kYGzzhZRbK+xOo=';
   ok := (aLen = LEN(sExp));
   IF ok THEN
      FOR i := 1 TO LEN(sExp) DO
         IF accept[i - 1] <> CHAR_TO_BYTE(sExp[i]) THEN ok := FALSE; END_IF;
      END_FOR;
   END_IF;
   acceptOk := ok;

   // ---------- 3) parse a masked binary frame ----------
   // FIN+binary=0x82, MASK+len2=0x82, mask 01 02 03 04, payload {AA,BB} masked
   fbuf[0]:=16#82; fbuf[1]:=16#82;
   fbuf[2]:=16#01; fbuf[3]:=16#02; fbuf[4]:=16#03; fbuf[5]:=16#04;
   fbuf[6]:=16#AB; fbuf[7]:=16#B9;              // {AA,BB} XOR mask {01,02}
   code := "FC_WS_ParseFrame"(offset := 0, avail := 8, buf := fbuf, frame := frame);
   frameOk := (code = 1)
              AND (frame.uiPayloadLen = 2)
              AND (frame.abPayload[0] = 16#AA)
              AND (frame.abPayload[1] = 16#BB)
              AND (frame.uiTotalLen = 8);

   // ---------- 4) build a 16-bit length frame header ----------
   FOR i := 0 TO 129 DO pl[i] := INT_TO_BYTE(i); END_FOR;
   flen := "FC_WS_BuildFrame"(opcode := 16#02, payLen := 130, payload := pl, outBuf := obuf);
   buildOk := (obuf[0] = 16#82)          // FIN+binary
              AND (obuf[1] = 126)         // 16-bit length marker
              AND (obuf[2] = 0)           // 130 >> 8
              AND (obuf[3] = 130)         // 130 & 0xFF
              AND (flen = 134);           // 4 header + 130 payload

   FC_WS_SelfTest := sha1Ok AND acceptOk AND frameOk AND buildOk;
END_FUNCTION


// --- OB1_Main.scl ---
// =====================================================================
//  Instance DB for the bridge + a cyclic OB (OB1) wiring the full loop.
//  Before download:
//    * create the CONFIGURED TCP connection (passive, local port 8082) and set
//      ConnectionID below to its "Local ID" (TIA default 16#0100).
// =====================================================================

DATA_BLOCK "DB_WS_Bridge"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
"FB_WS_Bridge"
BEGIN
END_DATA_BLOCK


ORGANIZATION_BLOCK "Main"
// OB1 - cyclic. For steadier 10 ms browser cadence, call this from a cyclic-
// interrupt OB (e.g. OB30 @ 10 ms) instead - see README "Timing".
VAR_TEMP
   pad : Array[0..19] of Byte;   // OB1 requires a >= 20-byte temp interface
END_VAR
BEGIN
   // 1) pack typed outputs -> little-endian wire image (webpage-generated FC)
   "FC_WS_MapOutputs"(app := "DB_WS_Output".App, raw := "DB_WS_Output".Raw);

   // 2) run the bridge - transfer is auto-sized from the two Raw arrays
   "DB_WS_Bridge"(Enable        := TRUE,
                  ConnectionID  := 16#0100,   // <-- MUST equal the configured connection's Local ID
                  WatchdogScans := 100,
                  OutRaw        := "DB_WS_Output".Raw,
                  InRaw         := "DB_WS_Input".Raw);

   // 3) on fresh data, unpack wire image -> typed inputs (webpage-generated FC)
   IF "DB_WS_Bridge".NewInputData THEN
      "FC_WS_MapInputs"(raw := "DB_WS_Input".Raw, app := "DB_WS_Input".App);
   END_IF;

   // ---------------------------------------------------------------
   //  YOUR CONTROL LOGIC  -  add it here.
   //    read  "DB_WS_Input".App.*    (values coming from the browser)
   //    write "DB_WS_Output".App.*   (values sent to the browser next scan)
   //
   //  Intentionally empty: this OB is part of the FIXED engine template and
   //  must compile for ANY dataset, so it names no specific fields. Write your
   //  machine / simulation logic here, e.g. a live round-trip mirror:
   //     "DB_WS_Output".App.<outField> := "DB_WS_Input".App.<inField>;
   // ---------------------------------------------------------------
   ;
END_ORGANIZATION_BLOCK
